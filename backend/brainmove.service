[Unit]
Description=Brainmove Teamproject
After=network.target
[Service]
ExecStart=/home/brainmove/brainmoveg2/backend/venv/bin/uvicorn main:app --log-level info --host 0.0.0.0 --port 8000
WorkingDirectory=/home/brainmove/brainmoveg2/backend
StandardOutput=inherit
StandardError=inherit
Restart=always
User=brainmove
[Install]
WantedBy=multi-user.target
